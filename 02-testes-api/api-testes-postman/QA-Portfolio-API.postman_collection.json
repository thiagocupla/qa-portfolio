              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "usuarios"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Cadastrar Usuário",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Valida se o usuário foi criado com sucesso (Status 201)\r",
                  "pm.test(\"Status code é 201 Created\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "// 2. Extrai e salva o ID do usuário no ambiente para usarmos no GET por ID / DELETE\r",
                  "const responseData = pm.response.json();\r",
                  "pm.environment.set(\"userID\", responseData._id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"nome\": \"QA Tester Portfolio\",\r\n  \"email\": \"qa_teste_{{$randomInt}}@portfolio.com\",\r\n  \"password\": \"teste\",\r\n  \"administrador\": \"true\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/usuarios",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "usuarios"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Buscar Usuário por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Valida se o Status é 200 OK\r",
                  "pm.test(\"Status code é 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// 2. Valida se o ID retornado é exatamente o mesmo que estava no ambiente\r",
                  "pm.test(\"Retornou o ID correto do usuário\", function () {\r",
                  "    const responseData = pm.response.json();\r",
                  "    pm.expect(responseData._id).to.eql(pm.environment.get(\"userID\"));\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/usuarios/{{userID}}",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "usuarios",
                "{{userID}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Excluir Usuário",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Valida se a exclusão respondeu 200 OK\r",
                  "pm.test(\"Status code é 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// 2. Valida a mensagem de confirmação da API\r",
                  "pm.test(\"Mensagem de exclusão com sucesso\", function () {\r",
                  "    const responseData = pm.response.json();\r",
                  "    pm.expect(responseData.message).to.eql(\"Registro excluído com sucesso\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/usuarios/{{userID}}",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "usuarios",
                "{{userID}}"
              ]
            }
          },
          "response": []
        }
      ]
