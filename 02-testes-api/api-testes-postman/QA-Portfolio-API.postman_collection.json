  "item": [
    {
      "name": "01 - Autenticação",
      "item": [
        {
          "name": "Login - sucesso",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Valida se o Status Code é 200 OK\r",
                  "pm.test(\"Status code é 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// 2. Extrai o token da resposta e salva no ambiente dinamicamente\r",
                  "const responseData = pm.response.json();\r",
                  "const tokenLimpo = responseData.authorization.replace(\"Bearer \", \"\");\r",
                  "pm.environment.set(\"token\", tokenLimpo);\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"fulano@qa.com\",\r\n  \"password\": \"teste\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/login",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login - Senha Invalida",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code é 400 ou 401\", function () {\r",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 401]);\r",
                  "});\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"fulano@qa.com\",\r\n  \"password\": \"senha_errada_123\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/login",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "login"
              ]
            }
          },
          "response": []
        }
